# backend/.env 로 복사해서 값을 채운다. **이 파일에는 값을 쓰지 않는다.**
#
#   cp backend/.env.example backend/.env
#
# 없어서 막혔던 것: .env가 gitignore인데 예시 파일이 없어서, 클론한 사람은
# 어떤 키가 필요한지 알 방법이 없었다.

# ── 필수 ────────────────────────────────────────────────
# Upstage. 파싱(Document Digitization)·개념 추출·학습 블록·문항 생성이 전부 이걸 쓴다.
# 없으면 서버는 뜨지만 파싱과 생성이 전부 실패한다.
UPSTAGE_API_KEY=

# docker compose가 넣어주므로 보통 비워 둔다.
# 컨테이너 밖에서 돌릴 때만: postgresql+psycopg://postgres:dev@localhost:5432/metalearn_v3
DATABASE_URL=

# 토큰 서명. 아무 긴 문자열이나.
SECRET_KEY=

# ── 선택 ────────────────────────────────────────────────
# 문제은행 교차 검증(EXAONE). 비워 두면 Solar 단독으로 검증한다.
EXAONE_API_KEY=

# 소셜 로그인. 비워 두면 그 제공자 버튼이 잠기고(GET /api/auth/providers), 로그인
# 없이도 화면은 전부 돈다(고정 dev 유저로 폴백).
# ⚠️ 제공자 콘솔의 Redirect URI에 아래 주소가 그대로 등록돼 있어야 한다:
#      http://localhost:8000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OAUTH_BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# 데모 촬영용 스위치. `1` 이면 파일 픽스처(tests/fixtures/*.md·*.tree.json)를
# 책장에 안 올린다 — 픽스처는 DB 행이 없어 **누구 책장에나** 뜨는데, 촬영할 땐
# 그게 잡음이 된다(시연 수업 셋에 픽스처 셋이 섞여 일곱 권이었다).
# 평소에는 비워 둔다 — 자료 없이 화면을 볼 수 있는 유일한 경로다.
#
# ⚠️ 아래 CURRICULUM_FIXTURES와 **다른 변수다.** 그건 픽스처 *디렉터리 경로*고
#    이건 on/off다. 한 이름에 둘을 담았다가 경로가 "off"가 되어 테스트 15개가
#    죽었다.
CURRICULUM_FIXTURES_OFF=

# 픽스처를 다른 데서 읽을 때만. 비우면 backend/tests/fixtures.
CURRICULUM_FIXTURES=

# 업로드 원본 저장 위치
UPLOAD_DIR=uploads
