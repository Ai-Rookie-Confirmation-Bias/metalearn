# MetaLearn backend — .env.example (복사 후 backend/.env 로 저장)
SECRET_KEY=change-me-in-production

# false = Seed/튜터 데이터 메모리만 (DB 미기록). true = PostgreSQL 저장
PERSIST_TO_DB=false

# Upstage Solar (메인 LLM)
UPSTAGE_API_KEY=
SOLAR_BASE_URL=https://api.upstage.ai/v1
SOLAR_MODEL=solar-pro3
SOLAR_EMBED_QUERY_MODEL=embedding-query
SOLAR_EMBED_PASSAGE_MODEL=embedding-passage
UPSTAGE_PARSE_MODEL=document-parse
